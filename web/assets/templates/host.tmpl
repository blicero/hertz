{{ define "host" }}
{{/* Created on 11. 06. 2026 */}}
{{/* Time-stamp: <2026-06-17 12:09:06 krylon> */}}
<!DOCTYPE html>
<html>
  {{ template "head" . }}

  <body>
    {{ template "intro" . }}

    <div class="body content">
      <h2>Histogram</h2>
      <table class="table table-striped freqtable">
        <thead>
          <tr>
            <td class="cnt">Frequency (MHz)</td>
            <td class="cnt">Cnt</td>
            <td class="cnt">%</td>
          </tr>
        </thead>

        <tbody>
          {{ $perc := .HistPercent }}
          {{ range $freq, $cnt := .Histogram }}
          <tr>
            <td class="cnt">{{ $freq }}</td>
            <td class="cnt">{{ $cnt }}</td>
            <td class="cnt">{{ fmt_float (index $perc $freq) }}</td>
          </tr>
          {{ end }}
        </tbody>
      </table>
    </div>

    <div id="chart">
      <img src="/host/{{ .Host.Name }}/chart?stride={{ .Stride }}" />
    </div>

    {{ template "footer" . }}
  </body>
</html>
{{ end }}
